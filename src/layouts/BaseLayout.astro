    <body>
        <header>
            <nav>
                <ul>
                    <li>
                        <a href="/index"><h1>home</h1></a>
                    </li>
                    <li>
                        <a href="/about"><h1>about</h1></a>
                    </li>
                    <li>
                        <a href="/space-catalog"><h1>space</h1></a>
                    </li>
                </ul>
            </nav>
        </header>
        <main>
            <slot />
